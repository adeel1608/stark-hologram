{
  "name": "spatial-digital-twin-interface",
  "version": "0.2.0",
  "private": true,
  "description": "A camera-driven spatial interface for exploring robotic digital twins with hand gestures and relative depth.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:run && npm run build"
  },
  "keywords": [
    "digital-twin",
    "robotics",
    "human-computer-interaction",
    "hand-tracking",
    "threejs",
    "mediapipe",
    "computer-vision"
  ],
  "author": "adeel1608",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/adeel1608/stark-hologram.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
